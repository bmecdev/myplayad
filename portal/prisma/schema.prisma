// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  CLIENT
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  isActive  Boolean  @default(true)
  
  planId        String?
  plan          Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  planStartsAt  DateTime?
  planEndsAt    DateTime?
  
  screens         Screen[]
  videos          Video[]
  updateSchedules UpdateSchedule[]
  rewardLeads     RewardLead[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Plan {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  description         String?
  maxVideosPerScreen  Int      @default(15)
  
  games       Game[]
  users       User[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Screen {
  id          String      @id @default(uuid())
  name        String
  location    String?
  description String?
  consoleId   String?     // Identificador de la consola física (ej: "consola1", "rpi5-01")
  orientation String      @default("PORTRAIT") // "PORTRAIT" (Vertical 9:16) | "LANDSCAPE" (Horizontal 16:9)
  lastSeen    DateTime?
  
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  displayState    String      @default("ON") // "ON" | "OFF"
  autoPowerEnabled Boolean    @default(true)
  powerOnTime      String?    @default("08:00") // Formato "HH:mm" (24h)
  powerOffTime     String?    @default("22:00") // Formato "HH:mm" (24h)
  
  schedules       Schedule[]
  updateSchedules UpdateSchedule[]
  rewardLeads     RewardLead[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Game {
  id          String      @id @default(uuid())
  name        String      // e.g. "Snake", "Invaders"
  slug        String      @unique // e.g. "snake"
  description String?
  
  plans       Plan[]
  schedules   Schedule[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Video {
  id          String      @id @default(uuid())
  title       String
  filename    String
  
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  schedules   Schedule[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Schedule {
  id          String    @id @default(uuid())
  screenId    String
  screen      Screen    @relation(fields: [screenId], references: [id], onDelete: Cascade)
  
  // A schedule can show a game OR a video
  gameId      String?
  game        Game?     @relation(fields: [gameId], references: [id])
  videoId     String?
  video       Video?    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  startDate   DateTime
  endDate     DateTime?
  
  isActive    Boolean   @default(true)

  // Configuración de Premios e Incentivos por Puntaje
  rewardEnabled       Boolean   @default(false)
  rewardMinScore      Int       @default(100)
  rewardTitle         String?   // Ej: "1 Café Americano Gratis"
  rewardExpireMinutes Int       @default(15) // Minutos para redimir en el establecimiento
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UpdateSchedule {
  id          String    @id @default(uuid())
  screenId    String?
  screen      Screen?   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType  String    // "SINGLE" | "CLIENT_ALL" | "SYSTEM_ALL"
  targetName  String?   // e.g. "Pantalla Central" o "Todas mis pantallas (4)" o "Toda la plataforma"
  scheduledAt DateTime
  executedAt  DateTime?
  status      String    @default("PENDING") // PENDING, EXECUTED, CANCELLED, FAILED
  resultNote  String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model RewardLead {
  id              String      @id @default(uuid())
  code            String      @unique // Código corto tipo "CAFE-8392"
  
  // Datos del Jugador / Lead
  name            String
  email           String
  whatsapp        String
  termsAccepted   Boolean     @default(true)
  acceptedAt      DateTime    @default(now())
  
  // Contexto del Juego y Pantalla
  gameSlug        String      // ej: "arkanoid"
  score           Int
  rewardTitle     String      // Copia del premio al momento de ganar
  
  // Multi-tenant: Relación con el Cliente (User)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Pantalla física donde jugó
  screenId        String
  screen          Screen      @relation(fields: [screenId], references: [id], onDelete: Cascade)
  
  // Estado del canje en el punto de venta
  status          String      @default("PENDING") // "PENDING" | "REDEEMED" | "EXPIRED"
  expiresAt       DateTime    // Fecha y hora límite para reclamar en caja
  redeemedAt      DateTime?   // Fecha y hora cuando el cajero/cliente lo validó en portal
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, email])
  @@index([userId, code])
  @@index([userId, status])
  @@index([screenId])
}

